diff --git a/uthreads.c b/uthreads.c
new file mode 100644
index 0000000..8216ee2
--- /dev/null
+++ b/uthreads.c
@@ -0,0 +1,48 @@
+#include "types.h"
+#include "user.h"
+#include "x86.h"
+
+
+#define THREAD_STACK_SZ (1024)
+int 
+thread_create(void (*start_routine)(void *, void *), void *arg1, void *arg2) 
+{
+    void *stack = malloc(THREAD_STACK_SZ);
+    return clone(start_routine, arg1, arg2, stack);
+}
+
+int 
+thread_join(void) 
+{
+    void *stack;
+    int pid = join(&stack);
+    if (pid < 0) {
+        return -1;
+    } else {
+        free(stack);
+        return pid;
+    }
+}
+
+
+void 
+lock_init(lock_t *lock) 
+{
+    lock->ticket = 0;
+    lock->turn = 0;
+}
+
+void 
+lock_acquire(lock_t * volatile lock) 
+{
+    uint myturn = xaddl(&lock->ticket, 1);
+    while (lock->turn != myturn)
+        ;
+}
+
+void 
+lock_release(lock_t * volatile lock) 
+{
+    xaddl(&lock->turn, 1);
+}
+
diff --git a/x86.h b/x86.h
index 07312a5..1c04c86 100644
--- a/x86.h
+++ b/x86.h
@@ -117,6 +117,16 @@ sti(void)
   asm volatile("sti");
 }
 
+static inline int 
+xaddl(uint *variable, uint value)
+{
+  asm volatile("lock; xaddl %0, %1"
+            : "+r" (value), "+m" (*variable)
+            :
+            : "memory");
+  return value;
+}
+
 static inline uint
 xchg(volatile uint *addr, uint newval)
 {
